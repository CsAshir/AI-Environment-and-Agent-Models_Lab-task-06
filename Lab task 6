 = [\n            [random.random() < dirt_probability for _ in range(cols)]\n            for _ in range(rows)\n        ]\n\n    def get_percept(self):\n        r, c = self.position\n\n        return {\n            \"position\": self.position,\n            \"is_dirty\": self.dirt[r][c]\n        }\n\n    def valid_moves(self):\n        r, c = self.position\n        moves = []\n\n        if c < self.cols - 1:\n            moves.append(\"Right\")\n        if c > 0:\n            moves.append(\"Left\")\n        if r < self.rows - 1:\n            moves.append(\"Down\")\n        if r > 0:\n            moves.append(\"Up\")\n\n        return moves\n\n    def apply_action(self, action):\n        r, c = self.position\n\n        if action == \"Suck\":\n            self.dirt[r][c] = False\n\n        elif action == \"Right\" and c < self.cols - 1:\n            self.position = (r, c + 1)\n\n        elif action == \"Left\" and c > 0:\n            self.position = (r, c - 1)\n\n        elif action == \"Down\" and r < self.rows - 1:\n            self.position = (r + 1, c)\n\n        elif action == \"Up\" and r > 0:\n            self.position = (r - 1, c)\n\n    def is_clean(self):\n        return not any(any(row) for row in self.dirt)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T05:04:09.458253Z","iopub.execute_input":"2026-10-12T05:04:09.458627Z","iopub.status.idle":"2026-10-12T05:04:09.470663Z","shell.execute_reply.started":"2026-10-12T05:04:09.458595Z","shell.execute_reply":"2026-10-12T05:04:09.469398Z"}},"outputs":[],"execution_count":15},{"cell_type":"code","source":"\ndef simple_reflex_agent(percept, env):\n    if percept[\"is_dirty\"]:\n        return \"Suck\"\n\n    return random.choice(env.valid_moves())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T05:04:16.217325Z","iopub.execute_input":"2026-10-12T05:04:16.217642Z","iopub.status.idle":"2026-10-12T05:04:16.223058Z","shell.execute_reply.started":"2026-10-12T05:04:16.2